{
  "name": "blackbox-flight-recorder",
  "version": "1.0.1",
  "description": "BLACKBOX — The Localhost Flight Recorder & Causal Time-Travel Bug Capsule System (Browser <-> Network <-> Backend Terminal <-> Git Diff + MCP)",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./sdk": "./src/sdk/browser-agent.js"
  },
  "bin": {
    "blackbox": "bin/blackbox.js",
    "blackbox-mcp": "bin/blackbox-mcp.js"
  },
  "files": [
    "bin/",
    "src/",
    "extension/",
    "install.sh",
    "install.ps1",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "preferGlobal": true,
  "scripts": {
    "start": "node ./bin/blackbox.js demo",
    "demo": "node ./bin/blackbox.js demo",
    "studio": "node ./bin/blackbox.js studio",
    "init": "node ./bin/blackbox.js init",
    "doctor": "node ./bin/blackbox.js doctor",
    "mcp": "node ./bin/blackbox-mcp.js",
    "test": "node ./test/verify-all.js"
  },
  "keywords": [
    "blackbox",
    "flight-recorder",
    "time-travel-debugging",
    "localhost",
    "bug-capsule",
    "mcp",
    "model-context-protocol",
    "devtools",
    "causal-tracing",
    "ai-debugging"
  ],
  "author": "Shourya Upadhyay",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0"
  }
}
