{
  "manifest_version": 3,
  "name": "BLACKBOX — Localhost Flight Recorder & Time-Travel Capsule",
  "version": "1.0.0",
  "description": "Zero-config 60s rolling flight recorder linking Browser DOM, Network Traces, Local Terminal stdout/stderr, and Git Diff.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BLACKBOX Localhost Flight Recorder"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "freeze-capsule": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Freeze a Blackbox Time-Travel Bug Capsule immediately"
    }
  }
}
