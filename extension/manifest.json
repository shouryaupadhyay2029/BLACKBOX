{
  "manifest_version": 3,
  "name": "BLACKBOX — Localhost Flight Recorder Agent",
  "version": "1.0.0",
  "description": "Zero-config localhost flight recorder agent. Automatically streams DOM snapshots, clicks, console errors, and HTTP trace IDs to Blackbox Daemon (:9876).",
  "permissions": ["tabs"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "BLACKBOX Flight Recorder",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "freeze-capsule": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Freeze 60-Second Time-Travel Bug Capsule"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "exclude_matches": [
        "http://localhost:9876/*",
        "http://127.0.0.1:9876/*"
      ],
      "js": ["inject.js"],
      "run_at": "document_start"
    }
  ]
}
